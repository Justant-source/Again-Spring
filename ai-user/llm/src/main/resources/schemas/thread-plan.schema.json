{
  "title": "Again Spring thread plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["post", "comments"],
  "properties": {
    "post": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "promo_title": {
          "type": ["string", "null"],
          "description": "IG hook: same characters as title with semantic newlines; each line ≤10 chars including spaces"
        },
        "capture_split_after_lines": {
          "type": ["array", "null"],
          "description": "1-based last block index of each part except the final; each part ≤8 non-empty newline blocks; max 4 parts; null when ≤8 blocks",
          "items": { "type": "integer", "minimum": 1 },
          "maxItems": 3
        },
        "capture_split_after_line": {
          "type": ["integer", "null"],
          "description": "Deprecated: single cut; promoted to capture_split_after_lines[0] when array absent"
        }
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "parentRef", "personaId", "body", "stance", "priority"],
        "properties": {
          "ref": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
          "parentRef": { "type": ["string", "null"] },
          "personaId": { "type": "string" },
          "body": { "type": "string" },
          "stance": { "type": ["string", "null"] },
          "priority": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
