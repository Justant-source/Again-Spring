{
  "title": "Again Spring paired Call1 (author + phase1 comments)",
  "type": "object",
  "additionalProperties": false,
  "required": ["post", "comments"],
  "properties": {
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "promo_title": {
          "type": ["string", "null"],
          "description": "Master SNS scroll-stop hook, independent of plaza title; optional semantic newlines; 4~80 chars flattened"
        },
        "hook_emotion": {
          "type": ["string", "null"],
          "description": "Dominant SNS hook emotion: shock|anger|tension|sad|hype"
        },
        "capture_split_after_lines": {
          "type": ["array", "null"],
          "description": "1-based last block index of each part except the final; each part ≤8 blocks; max 4 parts (paired body sum with partner ≤6 enforced downstream)",
          "items": { "type": "integer", "minimum": 1 },
          "maxItems": 3
        },
        "capture_split_after_line": {
          "type": ["integer", "null"],
          "description": "Deprecated single cut"
        },
        "metaphor_id": {
          "type": ["string", "null"],
          "description": "Best-fit metaphor illustration id from the 60-card catalog (e.g. empty-chair)"
        }
      }
    },
    "comments": {
      "type": "array",
      "description": "Phase1 top-level (and optional reply) candidates grounded on the author post only",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "parentRef", "personaId", "body", "stance", "priority"],
        "properties": {
          "ref": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
          "parentRef": { "type": ["string", "null"] },
          "personaId": { "type": "string" },
          "body": { "type": "string" },
          "stance": { "type": ["string", "null"] },
          "priority": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
