# ============================================================================
# 다시봄 (Again Spring) Environment Variables
# ============================================================================
# Copy this file to .env and fill in production values.
# NEVER commit .env to git — add to .gitignore

# ============================================================================
# MariaDB
# ============================================================================
# Root password. Used for initial container bootstrap — keep strong in prod.
MARIADB_ROOT_PASSWORD=changeme

# Application database name.
MARIADB_DATABASE=againspring

# Application (non-root) user that the backend connects with.
MARIADB_USER=againspring

# Application user's password.
MARIADB_PASSWORD=changeme

# ============================================================================
# JWT / Security
# ============================================================================
# Backend JWT signing secret. Must be at least 256 bits (32 bytes).
# Example: openssl rand -base64 32
# REQUIRED — no default
JWT_SECRET=
