#!/usr/bin/env bash
# pre-commit hook: frontend 변경 시 vitest 100% 통과 필수
#
# 설치: git config core.hooksPath .githooks
# 우회: SKIP_TESTS=1 git commit ... (긴급 상황 전용)
#
# e2e-realbe (Playwright 실 BE)는 prod 배포 전 게이트 — 커밋 단계에서 실행하지 않음.

set -euo pipefail

# ── 우회 옵션 ────────────────────────────────────────────────────────────────
if [[ "${SKIP_TESTS:-0}" == "1" ]]; then
  echo "[pre-commit] SKIP_TESTS=1 — 테스트 건너뜀 (긴급 상황 전용)"
  exit 0
fi

# ── FE 변경 감지 ─────────────────────────────────────────────────────────────
STAGED_FE=$(git diff --cached --name-only | grep '^frontend/' | head -1 || true)

if [[ -z "$STAGED_FE" ]]; then
  exit 0  # FE 파일 없으면 통과
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  [pre-commit] FE 변경 감지 → vitest 실행"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

REPO_ROOT="$(git rev-parse --show-toplevel)"
FE_DIR="$REPO_ROOT/frontend"

cd "$FE_DIR"
if ! npm test -- --reporter=verbose 2>&1; then
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  [pre-commit] ✗ vitest 실패 — 커밋 중단"
  echo "  수정 후 다시 커밋하세요."
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  exit 1
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  [pre-commit] ✓ vitest 통과 — 커밋 진행"
echo "  (e2e-realbe는 prod 배포 전 수동 실행 필수)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
