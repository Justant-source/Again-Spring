# 공통 ai-user 스택 환경 변수 — .env.ai-user 파일로 복사 후 사용
# 사용: docker compose -f docker-compose.ai-user.yml --env-file .env.ai-user up -d --build

# 공통 DB 연결 (prod DB 기준)
MARIADB_DATABASE=againspring
MARIADB_USER=againspring
MARIADB_PASSWORD=
DEV_MARIADB_PASSWORD=
DEV_DB_NAME=againspring_dev

# Claude / LLM
CLAUDE_HOST_CONFIG_DIR=/root/.claude
CLAUDE_BIN=claude
# Codex는 API key가 아니라 호스트 로그인 세션을 컨테이너 /root/.codex로 마운트한다.
CODEX_HOST_CONFIG_DIR=/home/justant/.codex
CODEX_BIN=codex
AI_USER_LLM_MODEL=claude-haiku-4-5-20251001
LLM_POST_MODEL=claude-sonnet-4-6
# workload alias가 LLM 서비스의 유일한 모델 환경변수 세트다.
AI_POST_CLAUDE_MODEL=claude-sonnet-4-6
AI_POST_CODEX_MODEL=gpt-5.6-terra
AI_INTERACTION_CLAUDE_MODEL=claude-haiku-4-5-20251001
AI_INTERACTION_CODEX_MODEL=gpt-5.6-luna
AI_USER_CLAUDE_POOL_SIZE=4
AI_USER_CODEX_POOL_SIZE=4
AI_USER_LLM_POOL_SIZE=20
AI_USER_LLM_QUEUE_CAPACITY=100
AI_USER_LLM_QUEUE_WAIT_TIMEOUT_MS=30000
AI_USER_LLM_DEFAULT_TIMEOUT_MS=240000
ANTHROPIC_API_KEY=
SELF_CRITIQUE_ENABLED=true
SELF_CRITIQUE_THRESHOLD=5
SELF_CRITIQUE_EXTRA_CLICHES=
LLM_API_REFUSAL_RETRIES=0
LLM_API_REFUSAL_FALLBACK_MODEL=

# 공통 ai-user 런타임 (prod 주력)
AI_USER_BACKEND_URL=http://againspring-backend-prod:8080
AI_USER_ENABLED=true
AI_USER_TICK_CRON=0 */10 * * * *
# LEGACY는 기존 publisher만, PLAN은 DB 기반 thread-plan publisher만 실행한다.
AI_USER_MODE=LEGACY
AI_USER_HUMAN_BATCH_CRON=0 */30 * * * *
AI_USER_DUE_ITEM_CRON=*/30 * * * * *
# PLAN 서브시스템(스레드플랜 생성/게시/human-reply 배치) 활성화 스위치.
# 실제 LEGACY/PLAN 선택은 DB ai_user_generation_config.scheduler_mode가 담당(AI_USER_MODE 아님).
AI_USER_THREAD_PLAN_ENABLED=false
AI_USER_THREAD_PLAN_PUBLISHER_ENABLED=false
AI_USER_HUMAN_REPLY_BATCH_ENABLED=false
# Human-reply delay / TTL (Wave1-I). TTL cleanup stays OFF — use admin force trigger for backlog wipe.
AI_USER_HUMAN_REPLY_DELAY_MINUTES_MIN=1
AI_USER_HUMAN_REPLY_DELAY_MINUTES_MAX=30
AI_USER_HUMAN_REPLY_INBOX_TTL_DAYS=7
AI_USER_HUMAN_REPLY_PLAN_TTL_DAYS=7
AI_USER_HUMAN_REPLY_TTL_CLEANUP_ENABLED=false
# WP3 matcher: 작성자 semantic 적합도 하한 (미만이면 신규 persona 자동 생성 경로)
AI_USER_MATCHER_AUTHOR_THRESHOLD=0.35
# §16.7 human-reply budgets / chunk (W6-B)
AI_USER_HUMAN_REPLY_CHUNK_SIZE=20
AI_USER_HUMAN_REPLY_RESPONDERS_MIN=0
AI_USER_HUMAN_REPLY_RESPONDERS_MAX=3
AI_USER_HUMAN_REPLY_DISTINCT_PERSONAS_MAX=3
AI_USER_HUMAN_REPLY_PER_PERSONA_MAX=5
AI_USER_HUMAN_REPLY_PER_POST_MAX=15
AI_USER_HUMAN_REPLY_CANDIDATE_MAX=8
# 예약글 파이프라인(ai_scheduled_posts) — 새벽 배치가 만든 예약글을 슬롯 도래 시 발행
AI_USER_SCHEDULED_POST_PUBLISHER_ENABLED=false
AI_USER_SCHEDULED_POST_PUBLISHER_CRON=0 * * * * *
AI_USER_SCHEDULED_POST_PUBLISH_BATCH_SIZE=5
AI_USER_POST_SLOT_MIN_SPACING_MINUTES=45
# 좋아요·조회수 리콘실러 (2026-07-31~, 배포 시 enabled=false로 배포 후 백필 검증 후 true 전환)
AI_USER_ENGAGEMENT_ENABLED=false
AI_USER_ENGAGEMENT_LOOKBACK_DAYS=3
AI_USER_ENGAGEMENT_MAX_POSTS_PER_RUN=40
AI_USER_ENGAGEMENT_MAX_LIKE_CALLS_PER_RUN=500
AI_USER_ENGAGEMENT_VIEWS_ENABLED=true
AI_USER_ENGAGEMENT_POST_LIKE_PER_VIEW=0.02
AI_USER_ENGAGEMENT_POST_LIKE_PER_COMMENT=0.6
AI_USER_ENGAGEMENT_COMMENT_LIKE_PER_VIEW=0.75
AI_USER_ENGAGEMENT_COMMENT_LIKE_PER_REPLY=1.0
AI_USER_ENGAGEMENT_COMMENT_LIKE_CAP=12
AI_USER_ENGAGEMENT_REPLY_LIKE_PER_VIEW=0.40
AI_USER_ENGAGEMENT_REPLY_LIKE_CAP=5
AI_USER_ENGAGEMENT_PERSONA_POOL_SIZE=60
AI_USER_ENGAGEMENT_COLD_LOGIN_BUDGET=3
AI_USER_ENGAGEMENT_VOTES_ENABLED=true
AI_USER_ENGAGEMENT_VOTE_PER_VIEW=0.15
AI_USER_ENGAGEMENT_VOTE_CAP=80
AI_USER_ENGAGEMENT_MAX_VOTE_CALLS_PER_RUN=40
AI_USER_ENGAGEMENT_MAX_VOTES_PER_POST_PER_RUN=8
AI_USER_ENGAGEMENT_VOTE_A_SHARE_MIN=0.44
AI_USER_ENGAGEMENT_VOTE_A_SHARE_MAX=0.80
AI_USER_ENGAGEMENT_POST_LIKES_ENABLED=true
AI_USER_ENGAGEMENT_CRON=0 */5 * * * *
AI_USER_PLAN_HARD_TTL_HOURS=24
AI_USER_PLAN_RETRY_MAX=1
AI_USER_POST_REPLAN_MAX=2
AI_USER_POST_EDIT_DEBOUNCE_MINUTES=30
AI_USER_PREGENERATE_MIN_MINUTES=30
AI_USER_PREGENERATE_MAX_MINUTES=90
AI_USER_ACTIVITY_LOOKBACK_DAYS=28
AI_USER_DAILY_GLOBAL_CAP=500
AI_USER_BOT_PASSWORD=ai-user-prod-pw-2026
AI_USER_SEED_ENABLED=true
AI_USER_REPETITION_THRESHOLD=0.45
AI_USER_PERSONA_TARGET=50
AI_USER_FORCE_ACTIVE=true
PAIRED_POST_ENABLED=false
PAIRED_POST_CRON=0 0 */2 * * *
PAIRED_POST_PAIRS=3
PAIRED_POST_TARGET_SHARE=0.15
PAIRED_POST_ROMANTIC_SHARE=0.80

# shared learning
AI_LEARNING_ENABLED=true
AI_LEARNING_CRAWL_ENABLED=false
AI_LEARNING_URL=http://againspring-ai-learning:8099
LLM_AI_USER_URL=http://againspring-llm-ai-user:8092

# 선택적 ML 리랭킹
AI_USER_ML_BASE_URL=http://100.115.252.61:8201
AI_USER_ML_API_TOKEN=aiuser-ml-api-token-dev-2026
AI_USER_ML_ENABLED=false
AI_USER_ML_ENABLED_COMMUNITIES=
AI_USER_ML_COLLECT=false
AI_USER_ML_BEST_OF_N=4
AI_USER_ML_TIMEOUT_MS=500

# prod → dev 일일 동기화
SYNC_CRON=30 5 * * *
SYNC_TIMEZONE=Asia/Seoul
SYNC_BACKFILL_DAYS=7

# Crawl ingest popularity gate (0~1). Posts below this in-batch relative pct are dropped.
CRAWL_MIN_POPULARITY_PCT=0.50
AI_USER_THREAD_PLAN_MICRO_BATCH_ENABLED=true
AI_USER_THREAD_PLAN_PLAN_PERSONA_CAST_MAX=40
