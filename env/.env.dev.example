# dev 환경 변수 — .env.dev 파일로 복사 후 값 입력
# 사용: docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build
#
# Bootstrap secrets only in env. App secrets live in MariaDB encrypted_secret —
# seed via scripts/seed_encrypted_secrets_from_env.py then remove from .env.

# MariaDB
MARIADB_ROOT_PASSWORD=changeme_dev
MARIADB_DATABASE=againspring_dev
MARIADB_USER=againspring
MARIADB_PASSWORD=changeme_dev

# AES-256-GCM vault master key (openssl rand -base64 32). Required to load encrypted_secret.
AS_SECRET_MASTER_KEY=

# LLM 워커 (againspring-llm-dev 컨테이너)
CLAUDE_HOST_CONFIG_DIR=/home/justant/.claude
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-haiku-4-5-20251001
REPORT_LLM_MODEL=claude-sonnet-4-6
LLM_POOL_SIZE=100
LLM_QUEUE_CAPACITY=500
LLM_QUEUE_WAIT_TIMEOUT_MS=30000

# Backend LLM 연결 (워크로드별 라우팅)
LLM_PROVIDER=remote                          # 레거시 호환 (llm.chat/report.provider 참조)
LLM_CHAT_PROVIDER=remote                     # 대화 LLM (remote=CLI via worker, claude-api=직접)
LLM_REPORT_PROVIDER=remote                   # 리포트 LLM (remote=CLI via worker, claude-api=직접)
LLM_WORKER_URL=http://againspring-llm-dev:8090

# Claude API knobs (key itself: encrypted_secret llm.anthropic_api_key or .env.ai-user for LLM containers)
LLM_API_CHAT_MODEL=claude-haiku-4-5-20251001
LLM_API_MAX_CONCURRENCY=8
LLM_API_CACHE_ENABLED=true
LLM_API_CACHE_TTL=5m

# OAuth2 — client IDs are public; client_secrets live in encrypted_secret
GOOGLE_CLIENT_ID=
KAKAO_CLIENT_ID=
NAVER_CLIENT_ID=

# App URL (소셜 로그인 redirect_uri 기준)
APP_URL=https://dev.againspring.net

# Email — password in encrypted_secret (mail.gmail_app_password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=againspring2026@gmail.com

# 위기 의견 알림 (선택 — 없으면 로그만)
CRISIS_WEBHOOK_URL=
CRISIS_EMAIL=

# ────────────────────────────────────────────────
# ASM (Again-Spring-Marketing 서비스 연결)
# tokens: encrypted_secret asm.api_token / asm.callback_token
# ────────────────────────────────────────────────
ASM_BASE_URL=http://100.115.252.61:8200
ASM_ENABLED=false
ASM_CALLBACK_BASE_URL=http://100.81.189.92:8090

# ────────────────────────────────────────────────
# 공통 AI-user 서비스 포인터
# 실제 orchestrator/llm/learning 런타임 설정은 .env.ai-user 에서 관리
# ────────────────────────────────────────────────
AI_LEARNING_URL=http://againspring-ai-learning:8099
AI_USER_LLM_URL=http://againspring-llm-ai-user:8092
AI_USER_ORCHESTRATOR_URL=http://againspring-ai-user-orchestrator:8096
