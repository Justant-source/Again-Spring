# dev 환경 변수 — .env.dev 파일로 복사 후 값 입력
# 사용: docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build

# MariaDB
MARIADB_ROOT_PASSWORD=changeme_dev
MARIADB_DATABASE=againspring_dev
MARIADB_USER=againspring
MARIADB_PASSWORD=changeme_dev

# JWT
JWT_SECRET=dev-only-change-me-at-least-256-bits-long-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM 워커 (againspring-llm-dev 컨테이너)
CLAUDE_HOST_CONFIG_DIR=/home/justant/.claude
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-haiku-4-5-20251001
REPORT_LLM_MODEL=claude-sonnet-4-6
LLM_POOL_SIZE=100
LLM_QUEUE_CAPACITY=500
LLM_QUEUE_WAIT_TIMEOUT_MS=30000

# Backend LLM 연결 (워크로드별 라우팅)
LLM_PROVIDER=remote                          # 레거시 호환 (llm.chat/report.provider 참조)
LLM_CHAT_PROVIDER=remote                     # 대화 LLM (remote=CLI via worker, claude-api=직접)
LLM_REPORT_PROVIDER=remote                   # 리포트 LLM (remote=CLI via worker, claude-api=직접)
LLM_WORKER_URL=http://againspring-llm-dev:8090

# Claude API (대화 경로 — dev에서는 기본 비활성, 스모크 테스트용)
ANTHROPIC_API_KEY=
LLM_API_CHAT_MODEL=claude-haiku-4-5-20251001
LLM_API_MAX_CONCURRENCY=8
LLM_API_CACHE_ENABLED=true
LLM_API_CACHE_TTL=5m

# OAuth2 (선택 — 없으면 소셜 로그인 비활성)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# App URL (소셜 로그인 redirect_uri 기준)
APP_URL=https://dev.againspring.net

# Email (Gmail App Password 사용. 없으면 이메일 인증 비활성)
# GMAIL_APP_PASSWORD: againspring2026@gmail.com Gmail → 2단계 인증 → 앱 비밀번호 (16자)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=againspring2026@gmail.com
GMAIL_APP_PASSWORD=

# 위기 의견 알림 (선택 — 없으면 로그만)
CRISIS_WEBHOOK_URL=
CRISIS_EMAIL=

# ────────────────────────────────────────────────
# ASM (Again-Spring-Marketing 서비스 연결)
# ────────────────────────────────────────────────
ASM_BASE_URL=http://100.115.252.61:8200
ASM_API_TOKEN=
ASM_ENABLED=false

# ────────────────────────────────────────────────
# AI 유저 시뮬레이션 (dev 전용)
# ────────────────────────────────────────────────
# 마스터 활성화 (기본 false — 직접 true로 설정해야 활성)
AI_USER_ENABLED=false

# 페르소나 시드 활성화 (첫 기동 시 roster.yml 로드)
AI_USER_SEED_ENABLED=true

# Cron 주기 (Spring cron 표현식, 기본 10분)
AI_USER_TICK_CRON=0 */10 * * * *

# 일일 전체 행동 상한
AI_USER_DAILY_GLOBAL_CAP=200

# 봇 계정 공통 비밀번호 (시딩 시 BCrypt 해시로 저장됨)
AI_USER_BOT_PASSWORD=ai-user-dev-pw-2026

# 내부망 URL (기본값 사용 가능 — docker DNS)
AI_USER_BACKEND_URL=http://againspring-backend-dev:8080
LLM_AI_USER_URL=http://againspring-llm-ai-user-dev:8092

# Haiku 워커 설정 (llm-ai-user 컨테이너용)
AI_USER_LLM_MODEL=claude-haiku-4-5-20251001
AI_USER_LLM_POOL_SIZE=20
AI_USER_LLM_QUEUE_CAPACITY=100
AI_USER_LLM_QUEUE_WAIT_TIMEOUT_MS=30000
AI_USER_LLM_DEFAULT_TIMEOUT_MS=120000

# 페르소나 히스토리 디렉토리 (호스트 경로, persona-history/ 마운트)
AI_USER_HISTORY_DIR=./persona-history
