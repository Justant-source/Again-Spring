# prod 환경 변수 — .env.prod 파일로 복사 후 실제 값 입력
# 사용: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ⚠️ .env.prod 는 절대 git에 커밋하지 않음

# MariaDB (기본값 없음 — 반드시 설정)
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=againspring
MARIADB_USER=againspring
MARIADB_PASSWORD=

# JWT (32자 이상 랜덤 문자열)
JWT_SECRET=

# Claude Code CLI
CLAUDE_HOST_CONFIG_DIR=/root/.claude
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-haiku-4-5-20251001
LLM_PROVIDER=claude-code
ANTHROPIC_API_KEY=

# OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# App URL
APP_URL=https://againspring.net

# Email (필수)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
