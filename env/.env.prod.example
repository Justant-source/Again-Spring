# prod 환경 변수 — .env.prod 파일로 복사 후 실제 값 입력
# 사용: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ⚠️ .env.prod 는 절대 git에 커밋하지 않음
#
# Bootstrap secrets only in env. App secrets (JWT/OAuth/mail/ASM client tokens/
# GitHub PAT) live in MariaDB encrypted_secret — seed via
# scripts/seed_encrypted_secrets_from_env.py then remove from .env.

# MariaDB (기본값 없음 — 반드시 설정)
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=againspring
MARIADB_USER=againspring
MARIADB_PASSWORD=

# AES-256-GCM vault master key (openssl rand -base64 32). Required to load encrypted_secret.
AS_SECRET_MASTER_KEY=

# LLM 워커 (base stack againspring-llm 컨테이너)
CLAUDE_HOST_CONFIG_DIR=/root/.claude
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-haiku-4-5-20251001
REPORT_LLM_MODEL=claude-sonnet-4-6
LLM_POOL_SIZE=100
LLM_QUEUE_CAPACITY=500
LLM_QUEUE_WAIT_TIMEOUT_MS=30000
# Claude CLI 실행 제한(10분) 및 backend→bridge 요청 제한(실행 제한보다 여유 10초)
LLM_DEFAULT_TIMEOUT_MS=600000
LLM_REMOTE_DEFAULT_TIMEOUT_MS=600000
LLM_REMOTE_READ_TIMEOUT_MS=610000
LLM_PROCESS_TERMINATION_GRACE_MS=2000

# Backend LLM 연결 — dev/prod 모두 CLI 브릿지(remote) 사용
# 실시간 응답 불필요 → ANTHROPIC_API_KEY 불필요, ~/.claude 마운트로 인증
LLM_PROVIDER=remote
LLM_CHAT_PROVIDER=remote
LLM_REPORT_PROVIDER=remote
LLM_WORKER_URL=http://againspring-llm:8090

# OAuth2 — client IDs are public; client_secrets live in encrypted_secret
GOOGLE_CLIENT_ID=
KAKAO_CLIENT_ID=
NAVER_CLIENT_ID=

# App URL
APP_URL=https://againspring.net

# Email — password in encrypted_secret (mail.gmail_app_password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=againspring2026@gmail.com

# 위기 의견 알림 (선택 — 없으면 로그만)
CRISIS_WEBHOOK_URL=
CRISIS_EMAIL=

# 공통 AI-user 서비스 포인터
# 실제 orchestrator/llm/learning 런타임 설정은 .env.ai-user 에서 관리
AI_LEARNING_URL=http://againspring-ai-learning:8099
AI_USER_LLM_URL=http://againspring-llm-ai-user:8092
AI_USER_ORCHESTRATOR_URL=http://againspring-ai-user-orchestrator:8096

# ASM (마케팅) — tokens in encrypted_secret (asm.api_token / asm.callback_token)
ASM_BASE_URL=http://100.115.252.61:8200
ASM_ENABLED=true
ASM_X_THREAD_PUBLISH_TRIGGER_ENABLED=true
# ISO-8601 Instant. 이 시각 이후 생성 글만 24h 후 X/IG 자동 발행 (비우면 fail-closed)
ASM_AUTO_PUBLISH_SINCE=2026-08-02T08:43:52Z

# 마케팅 렌더 프로필 (WS6.1) — 기본 marketing_fast (v1), v2 전환 시 marketing_v2
MARKETING_RENDER_PROFILE=marketing_fast
