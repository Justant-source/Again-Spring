{
  "name": "again-spring",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-legal.mjs && node scripts/gen-categories.mjs && node scripts/gen-api-types.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-legal.mjs && node scripts/gen-categories.mjs && node scripts/gen-api-types.mjs",
    "gen:types": "node scripts/gen-api-types.mjs",
    "gen:categories": "node scripts/gen-categories.mjs",
    "check:categories": "node scripts/gen-categories.mjs --check",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:words": "node scripts/check-forbidden-words.js",
    "lint:emoji": "node scripts/check-no-emoji.js",
    "verify:assets": "node scripts/verify-design-assets.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:e2e:realbe": "playwright test --config=playwright.realbe.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "axios": "^1.7.7",
    "cmdk": "^0.2.1",
    "framer-motion": "^11.11.17",
    "html2canvas": "^1.4.1",
    "next": "14.2.15",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-markdown": "^9.1.0",
    "recharts": "^2.13.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "jsdom": "^29.1.0",
    "lucide-react": "^1.17.0",
    "msw": "^2.6.4",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
