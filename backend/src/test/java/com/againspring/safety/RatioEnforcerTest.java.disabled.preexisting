package com.againspring.safety;

import static org.junit.jupiter.api.Assertions.*;

import com.againspring.domain.enums.ConflictType;
import com.againspring.service.report.RatioEnforcer;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;

/**
 * Unit tests for RatioEnforcer.
 *
 * 100% coverage target. Tests all clipping rules, rounding, edge cases.
 *
 * Coverage:
 * - Factual: no clipping (100:0 allowed), just rounding
 * - Difference: 70:30 max, clipping if either > 70
 * - Mixed: 85:15 max, clipping if either > 85
 * - 5-unit rounding (67→65, 68→70, etc.)
 * - Sum adjustment enforcement (73+28=101 → 75+25)
 * - Illegal input validation (negative, >100, bad sum)
 * - Exact boundary conditions (exactly 70, 85, 100)
 * - Original values preserved in result
 */
@SpringBootTest
@DisplayName("RatioEnforcer Tests")
class RatioEnforcerTest {

	@Autowired
	private RatioEnforcer ratioEnforcer;

	@BeforeEach
	void setUp() {
		assertNotNull(ratioEnforcer, "RatioEnforcer should be autowired");
	}

	// ========== FACTUAL TYPE ==========

	@Test
	@DisplayName("Factual: 100:0 allowed without clipping")
	void testFactualMaxRatio() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.FACTUAL, 100, 0, "test");

		assertEquals(100, result.getAPct());
		assertEquals(0, result.getBPct());
		assertTrue(result.isValid());
		assertFalse(result.wasClipped());
	}

	@Test
	@DisplayName("Factual: 75:25 unchanged")
	void testFactualNormalRatio() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.FACTUAL, 75, 25, "test");

		assertEquals(75, result.getAPct());
		assertEquals(25, result.getBPct());
		assertTrue(result.isValid());
		assertFalse(result.wasClipped());
	}

	@Test
	@DisplayName("Factual: applies 5-unit rounding (67→65)")
	void testFactualRoundingDown() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.FACTUAL, 67, 33, "test");

		assertEquals(65, result.getAPct());
		assertEquals(35, result.getBPct());
		assertTrue(result.isValid());
		assertTrue(result.wasClipped()); // rounding counts as clipping
	}

	@Test
	@DisplayName("Factual: applies 5-unit rounding (68→70)")
	void testFactualRoundingUp() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.FACTUAL, 68, 32, "test");

		assertEquals(70, result.getAPct());
		assertEquals(30, result.getBPct());
		assertTrue(result.isValid());
		assertTrue(result.wasClipped());
	}

	// ========== DIFFERENCE TYPE ==========

	@Test
	@DisplayName("Difference: 70:30 max, exactly at limit")
	void testDifferenceAtLimit() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.DIFFERENCE, 70, 30, "test");

		assertEquals(70, result.getAPct());
		assertEquals(30, result.getBPct());
		assertTrue(result.isValid());
		assertFalse(result.wasClipped());
	}

	@Test
	@DisplayName("Difference: 85:15 clipped to 70:30")
	void testDifferenceExceededAndClipped() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.DIFFERENCE, 85, 15, "test");

		assertEquals(70, result.getAPct());
		assertEquals(30, result.getBPct());
		assertTrue(result.isValid());
		assertTrue(result.wasClipped());
		assertEquals(85, result.getOriginalA());
		assertEquals(15, result.getOriginalB());
	}

	@Test
	@DisplayName("Difference: 30:70 at limit (B side)")
	void testDifferenceBSideAtLimit() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.DIFFERENCE, 30, 70, "test");

		assertEquals(30, result.getAPct());
		assertEquals(70, result.getBPct());
		assertTrue(result.isValid());
		assertFalse(result.wasClipped());
	}

	@Test
	@DisplayName("Difference: 15:85 clipped to 30:70")
	void testDifferenceBSideExceeded() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.DIFFERENCE, 15, 85, "test");

		assertEquals(30, result.getAPct());
		assertEquals(70, result.getBPct());
		assertTrue(result.isValid());
		assertTrue(result.wasClipped());
	}

	@Test
	@DisplayName("Difference: 55:45 within limit, no clipping")
	void testDifferenceWithinLimit() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.DIFFERENCE, 55, 45, "test");

		assertEquals(55, result.getAPct());
		assertEquals(45, result.getBPct());
		assertTrue(result.isValid());
		assertFalse(result.wasClipped());
	}

	// ========== MIXED TYPE ==========

	@Test
	@DisplayName("Mixed: 85:15 max, exactly at limit")
	void testMixedAtLimit() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.MIXED, 85, 15, "test");

		assertEquals(85, result.getAPct());
		assertEquals(15, result.getBPct());
		assertTrue(result.isValid());
		assertFalse(result.wasClipped());
	}

	@Test
	@DisplayName("Mixed: 95:5 clipped to 85:15")
	void testMixedExceeded() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.MIXED, 95, 5, "test");

		assertEquals(85, result.getAPct());
		assertEquals(15, result.getBPct());
		assertTrue(result.isValid());
		assertTrue(result.wasClipped());
	}

	@Test
	@DisplayName("Mixed: 15:85 clipped to 15:85")
	void testMixedBSideAtLimit() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.MIXED, 15, 85, "test");

		assertEquals(15, result.getAPct());
		assertEquals(85, result.getBPct());
		assertTrue(result.isValid());
		assertFalse(result.wasClipped());
	}

	@Test
	@DisplayName("Mixed: 5:95 clipped to 15:85")
	void testMixedBSideExceeded() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.MIXED, 5, 95, "test");

		assertEquals(15, result.getAPct());
		assertEquals(85, result.getBPct());
		assertTrue(result.isValid());
		assertTrue(result.wasClipped());
	}

	@Test
	@DisplayName("Mixed: 60:40 within limit")
	void testMixedWithinLimit() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.MIXED, 60, 40, "test");

		assertEquals(60, result.getAPct());
		assertEquals(40, result.getBPct());
		assertTrue(result.isValid());
		assertFalse(result.wasClipped());
	}

	// ========== ROUNDING EDGE CASES ==========

	@Test
	@DisplayName("Rounding: 50:50 exact boundary")
	void testRoundingExact50() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.FACTUAL, 50, 50, "test");

		assertEquals(50, result.getAPct());
		assertEquals(50, result.getBPct());
		assertTrue(result.isValid());
		assertFalse(result.wasClipped());
	}

	@Test
	@DisplayName("Rounding: 62 rounds to 60")
	void testRounding62to60() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.FACTUAL, 62, 38, "test");

		assertEquals(60, result.getAPct());
		assertEquals(40, result.getBPct());
		assertTrue(result.isValid());
	}

	@Test
	@DisplayName("Rounding: 63 rounds to 65")
	void testRounding63to65() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.FACTUAL, 63, 37, "test");

		assertEquals(65, result.getAPct());
		assertEquals(35, result.getBPct());
		assertTrue(result.isValid());
	}

	@Test
	@DisplayName("Rounding: 73+28=101 adjusted to 75+25")
	void testSumAdjustmentRoundingCarry() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.FACTUAL, 73, 27, "test");

		assertEquals(75, result.getAPct());
		assertEquals(25, result.getBPct());
		assertEquals(100, result.getAPct() + result.getBPct());
	}

	// ========== INVALID INPUT HANDLING ==========

	@Test
	@DisplayName("Throws: negative percentage")
	void testThrowsNegative() {
		assertThrows(IllegalArgumentException.class,
			() -> ratioEnforcer.clip(ConflictType.FACTUAL, -10, 110, "test")
		);
	}

	@Test
	@DisplayName("Throws: percentage > 100")
	void testThrowsOver100() {
		assertThrows(IllegalArgumentException.class,
			() -> ratioEnforcer.clip(ConflictType.FACTUAL, 101, -1, "test")
		);
	}

	@Test
	@DisplayName("Throws: sum way off (90 total)")
	void testThrowsBadSum() {
		assertThrows(IllegalArgumentException.class,
			() -> ratioEnforcer.clip(ConflictType.FACTUAL, 45, 45, "test")
		);
	}

	@Test
	@DisplayName("Throws: sum way off (110 total)")
	void testThrowsBadSumHigh() {
		assertThrows(IllegalArgumentException.class,
			() -> ratioEnforcer.clip(ConflictType.FACTUAL, 56, 55, "test")
		);
	}

	// ========== TOLERANCE RANGE ==========

	@Test
	@DisplayName("Accepts sum=95 (within tolerance)")
	void testAcceptsSumLow() {
		// 95 is within tolerance (95-105 range)
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.FACTUAL, 48, 47, "test");
		assertNotNull(result);
	}

	@Test
	@DisplayName("Accepts sum=105 (within tolerance)")
	void testAcceptsSumHigh() {
		// 105 is within tolerance
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.FACTUAL, 52, 53, "test");
		assertNotNull(result);
	}

	// ========== ORIGINAL VALUES PRESERVATION ==========

	@Test
	@DisplayName("Preserves original values after clipping")
	void testPreservesOriginalValues() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.DIFFERENCE, 85, 15, "test");

		assertEquals(85, result.getOriginalA());
		assertEquals(15, result.getOriginalB());
		assertEquals(70, result.getAPct()); // but clipped
		assertEquals(30, result.getBPct());
	}

	@Test
	@DisplayName("Original values null if no clipping")
	void testOriginalValuesPreservedAlways() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.FACTUAL, 50, 50, "test");

		assertNotNull(result.getOriginalA());
		assertNotNull(result.getOriginalB());
		assertEquals(50, result.getOriginalA());
		assertEquals(50, result.getOriginalB());
	}

	// ========== CLIP AMOUNT CALCULATION ==========

	@Test
	@DisplayName("Clip amount calculation")
	void testClipAmountCalculation() {
		EnforcedRatio result = ratioEnforcer.clip(ConflictType.DIFFERENCE, 85, 15, "test");

		int clipAmount = result.getClipAmount();
		assertEquals(15, clipAmount); // 85 → 70 is 15 units
	}

	// ========== TYPE FIELD ==========

	@Test
	@DisplayName("Result carries correct conflict type")
	void testResultCarriesType() {
		EnforcedRatio result1 = ratioEnforcer.clip(ConflictType.FACTUAL, 70, 30, "test");
		assertEquals(ConflictType.FACTUAL, result1.getType());

		EnforcedRatio result2 = ratioEnforcer.clip(ConflictType.DIFFERENCE, 70, 30, "test");
		assertEquals(ConflictType.DIFFERENCE, result2.getType());

		EnforcedRatio result3 = ratioEnforcer.clip(ConflictType.MIXED, 85, 15, "test");
		assertEquals(ConflictType.MIXED, result3.getType());
	}
}
