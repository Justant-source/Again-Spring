#!/usr/bin/env python3
"""Git credential helper: read GitHub PATs from AS encrypted_secret vault.

SSOT: MariaDB `encrypted_secret` rows `github.pat.<username>` (AES-GCM).
Bootstrap: `AS_SECRET_MASTER_KEY` + MariaDB access (env or env/.env.prod|dev).

Install (repo):
  git config credential.helper '!/home/justant/Data/Again-Spring/scripts/git-credential-as-vault'

Never prints tokens to stderr. On miss/failure, exits 0 with no password
(git may fall through to other helpers).
"""
from __future__ import annotations

import base64
import os
import subprocess
import sys
from pathlib import Path

from cryptography.hazmat.primitives.ciphers.aead import AESGCM

REPO_ROOT = Path(__file__).resolve().parents[1]
VAULT_PREFIX = "github.pat."


def _load_dotenv(path: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    if not path.is_file():
        return out
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        out[k.strip()] = v.strip().strip('"').strip("'")
    return out


def _bootstrap() -> dict[str, str]:
    """Merge env files under env/ then process env (process wins)."""
    merged: dict[str, str] = {}
    for name in (".env.prod", ".env.dev"):
        merged.update(_load_dotenv(REPO_ROOT / "env" / name))
    for k, v in os.environ.items():
        if v:
            merged[k] = v
    return merged


def _decrypt(master_b64: str, enc_blob: str) -> str:
    key = base64.b64decode(master_b64)
    if len(key) != 32:
        raise RuntimeError("AS_SECRET_MASTER_KEY must be 32 bytes base64")
    raw = base64.b64decode(enc_blob)
    if len(raw) < 13:
        raise RuntimeError("enc_blob too short")
    return AESGCM(key).decrypt(raw[:12], raw[12:], None).decode("utf-8").strip()


def _fetch_enc_blob(cfg: dict[str, str], secret_key: str) -> str | None:
    """Prefer docker exec against prod/dev MariaDB; fall back to local mysql client."""
    user = cfg.get("MARIADB_USER") or cfg.get("DB_USER") or "againspring"
    password = cfg.get("MARIADB_PASSWORD") or cfg.get("DB_PASSWORD") or ""
    database = cfg.get("MARIADB_DATABASE") or cfg.get("DB_NAME") or "againspring"
    # GitHub usernames / vault keys are alphanumeric + ._- only; still escape quotes.
    safe_key = secret_key.replace("\\", "\\\\").replace("'", "''")
    sql = f"SELECT enc_blob FROM encrypted_secret WHERE secret_key='{safe_key}' LIMIT 1"

    containers = [
        c.strip()
        for c in (
            cfg.get("AS_VAULT_DB_CONTAINER")
            or "againspring-mariadb-prod,againspring-mariadb,againspring-mariadb-dev"
        ).split(",")
        if c.strip()
    ]
    for container in containers:
        try:
            out = subprocess.check_output(
                [
                    "docker",
                    "exec",
                    container,
                    "mariadb",
                    "-u",
                    user,
                    f"-p{password}",
                    database,
                    "-N",
                    "-B",
                    "-e",
                    sql,
                ],
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=10,
            )
        except (subprocess.CalledProcessError, FileNotFoundError, subprocess.TimeoutExpired):
            continue
        blob = out.strip()
        if blob:
            return blob
    return None


def _parse_fill(stdin: str) -> dict[str, str]:
    attrs: dict[str, str] = {}
    for line in stdin.splitlines():
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        attrs[k.strip()] = v.strip()
    return attrs


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] != "get":
        # store/erase: vault is SSOT — ignore (do not write plaintext files)
        return 0

    attrs = _parse_fill(sys.stdin.read())
    host = attrs.get("host", "")
    if host not in ("github.com", "www.github.com"):
        return 0
    username = attrs.get("username", "").strip()
    if not username:
        # git often asks without username; repo default account
        username = "Justant-source"
        attrs["username"] = username

    cfg = _bootstrap()
    master = (cfg.get("AS_SECRET_MASTER_KEY") or "").strip()
    if not master:
        print("git-credential-as-vault: AS_SECRET_MASTER_KEY missing", file=sys.stderr)
        return 0

    secret_key = f"{VAULT_PREFIX}{username}"
    try:
        blob = _fetch_enc_blob(cfg, secret_key)
        if not blob:
            print(
                f"git-credential-as-vault: no vault row for {secret_key}",
                file=sys.stderr,
            )
            return 0
        token = _decrypt(master, blob)
    except Exception as exc:  # noqa: BLE001
        print(f"git-credential-as-vault: {type(exc).__name__}", file=sys.stderr)
        return 0

    # Echo requested attrs + password (git credential protocol)
    for key in ("protocol", "host", "path", "username"):
        if key in attrs and attrs[key]:
            sys.stdout.write(f"{key}={attrs[key]}\n")
    if "username" not in attrs:
        sys.stdout.write(f"username={username}\n")
    sys.stdout.write(f"password={token}\n")
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
